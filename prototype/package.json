{
  "name": "hitopia-monitoring",
  "version": "0.2.0",
  "private": true,
  "description": "Hitopia Monitoring & Monthly Report — full-stack Next.js app (Postgres/Prisma) serving the foundation contract API with real data integration, scoring, AI insight, and client reporting.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:login": "tsx prisma/seed-login.ts",
    "db:reset": "tsx prisma/reset.ts",
    "db:reset:seed": "tsx prisma/reset.ts --seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "jose": "^5.9.6",
    "next": "^15.1.6",
    "openai": "^4.77.0",
    "papaparse": "^5.4.1",
    "pg": "^8.13.1",
    "pptxgenjs": "^4.0.1",
    "puppeteer": "^23.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}