# Hitopia Monitoring — environment template.
# Copy to .env (gitignored) and fill in. Secrets NEVER go in the repo (R8);
# in production load these from a secret manager (Doppler / cloud secret manager).

# --- Database (required) ---
DATABASE_URL="postgresql://USER@localhost:5432/hitopia_monitoring?schema=public"

# --- Session / app (required) ---
# 32+ char random string. Generate: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"
# Comma-separated Google Workspace domains allowed to sign in.
AUTH_ALLOWED_DOMAIN="hitopia.id"
# Dev role-picker sign-in (no Google OAuth). MUST be unset/false in production.
AUTH_DEV_LOGIN="true"

# --- Google OAuth (Phase 2 — Auth.js) ---
AUTH_SECRET=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# --- Redis / worker (Phase 3) ---
REDIS_URL="redis://localhost:6379"

# --- Google Sheets ingestion (Phase 3) ---
# Service-account JSON, base64-encoded: base64 -i service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=""
GSHEET_TALENT_SPREADSHEET_ID=""
GSHEET_TALENT_RANGE="Talents!A1:Z"

# --- Jira ingestion (Phase 3) ---
JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""

# --- Clockify ingestion (Phase 3) ---
CLOCKIFY_API_KEY=""
CLOCKIFY_WORKSPACE_ID=""

# --- AI insights (OpenAI-compatible: any provider with base URL + key) ---
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
